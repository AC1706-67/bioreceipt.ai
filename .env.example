# BioPulse.AI Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=2000

# Google AI Configuration
GOOGLE_AI_API_KEY=your_google_ai_key
GOOGLE_AI_MODEL=gemini-pro
GOOGLE_AI_MAX_TOKENS=2000

# Ollama Configuration (for local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_ENABLED=false

# HuggingFace Configuration
HUGGINGFACE_API_KEY=hf_your_huggingface_key
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium
HUGGINGFACE_ENABLED=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_AI_FEATURES=true
ENABLE_OFFLINE_MODE=true
ENABLE_SOCIAL_FEATURES=true
ENABLE_PHOTO_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_WEARABLE_INTEGRATION=true

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================
ANALYTICS_ENABLED=true
CRASHLYTICS_ENABLED=true
PERFORMANCE_MONITORING=true

# Sentry Configuration (Error Tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=development

# Mixpanel Configuration (Analytics)
MIXPANEL_TOKEN=your_mixpanel_token

# =============================================================================
# PUSH NOTIFICATIONS
# =============================================================================
FCM_SERVER_KEY=your_fcm_server_key
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
ENCRYPTION_KEY=your_32_character_encryption_key
JWT_SECRET=your_jwt_secret_key
HIPAA_COMPLIANCE_MODE=true
AUDIT_LOGGING_ENABLED=true

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
NODE_ENV=development
DEBUG_MODE=true
LOG_LEVEL=debug
API_TIMEOUT=30000

# Metro Configuration
METRO_PORT=8081
METRO_HOST=localhost

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/biopulse_test
MOCK_AI_RESPONSES=false
E2E_TEST_TIMEOUT=60000

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
APP_VERSION=1.0.0
BUILD_NUMBER=1
BUNDLE_ID=com.biopulse.ai
APP_NAME=BioPulse.AI

# Code Push Configuration (for OTA updates)
CODEPUSH_DEPLOYMENT_KEY_ANDROID=your_android_deployment_key
CODEPUSH_DEPLOYMENT_KEY_IOS=your_ios_deployment_key

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Apple Health Integration
APPLE_HEALTH_ENABLED=true

# Google Fit Integration
GOOGLE_FIT_ENABLED=true
GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id

# Stripe Payment Processing (if applicable)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
MAX_PHOTO_SIZE_MB=10
MAX_PHOTOS_PER_USER=1000
CACHE_SIZE_MB=100
OFFLINE_STORAGE_MB=500

# =============================================================================
# RATE LIMITING
# =============================================================================
API_RATE_LIMIT_PER_MINUTE=100
AI_REQUESTS_PER_HOUR=50
PHOTO_UPLOADS_PER_DAY=100

# =============================================================================
# LOCALIZATION
# =============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh
RTL_LANGUAGES=ar,he,fa

# =============================================================================
# ACCESSIBILITY
# =============================================================================
ACCESSIBILITY_FEATURES_ENABLED=true
VOICE_CONTROL_ENABLED=true
HIGH_CONTRAST_MODE=false
LARGE_TEXT_SUPPORT=true

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================
PERFORMANCE_SAMPLING_RATE=0.1
MEMORY_WARNING_THRESHOLD_MB=100
NETWORK_TIMEOUT_MS=10000

# =============================================================================
# BACKUP & SYNC
# =============================================================================
AUTO_BACKUP_ENABLED=true
BACKUP_FREQUENCY_HOURS=24
SYNC_INTERVAL_MINUTES=15
CONFLICT_RESOLUTION_STRATEGY=server_wins